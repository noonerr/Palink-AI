# ============================================================
# Palink-AI 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ============================================================

# ── 安全配置（生产环境必须设置） ──────────────────────────────
# 应用运行环境: development / production
APP_ENV=development

# JWT 签名密钥（生产环境必须设置为强随机字符串）
SECRET_KEY=change-me-to-a-strong-random-string

# 管理员默认密码（生产环境必须设置强密码）
ADMIN_PASSWORD=change-me-to-a-strong-password

# Token 过期时间（分钟），默认 1440 = 24小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 密码策略
PASSWORD_MIN_LENGTH=8
REQUIRE_PASSWORD_MIXED_CASE=true
REQUIRE_PASSWORD_DIGIT=true

# CORS 跨域配置（生产环境必须设置具体域名，多个用逗号分隔）
CORS_ORIGINS=*

# 是否信任代理头（仅在反向代理后启用）
TRUST_PROXY_HEADERS=false

# ── 数据库配置 ──────────────────────────────────────────────
# SQLite: sqlite:///./data/palink.db
# PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/palink.db

# PostgreSQL 连接池配置
DB_USER=ai_user
DB_PASSWORD=ai_password
DB_NAME=ai_hub

# 连接池参数
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=8
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_AUTO_TUNE=true
DB_CONNECTION_BUDGET=40

# ── 数据目录配置 ────────────────────────────────────────────
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
WORKSPACE_DIR=./data/workspace

# ── API Key 加密密钥（MED-6，推荐生产设置）──────────────────
# 为空时后端自动生成密钥并持久化到 DATA_DIR/.api_key_encryption_key
# ——该文件与加密数据同目录，拿到备份即可解密全部 API Key。
# 生产环境请通过此环境变量注入 32+ 字符强随机串，且不要随数据备份分发。
# API_KEY_ENCRYPTION_KEY=

# ── 聊天文件上传配置 ────────────────────────────────────────
# 单文件最大大小（MB）
CHAT_UPLOAD_MAX_FILE_SIZE_MB=20

# 用户存储配额（MB）
CHAT_UPLOAD_MAX_USER_STORAGE_MB=1024

# 允许的文件扩展名（逗号分隔）
CHAT_UPLOAD_ALLOWED_EXTENSIONS=.png,.jpg,.jpeg,.webp,.gif,.pdf,.doc,.docx,.xls,.xlsx,.txt,.zip,.rar,.7z,.tar,.gz,.csv,.json,.md,.css,.js,.ts,.jsx,.tsx,.py,.java,.cpp,.c,.h,.go,.rs,.rb,.php,.swift,.kt,.xml,.yaml,.yml,.toml,.ini,.cfg

# 禁止的文件扩展名（逗号分隔，优先级高于允许列表）
CHAT_UPLOAD_BLOCKED_EXTENSIONS=.exe,.dll,.bat,.cmd,.com,.msi,.scr,.ps1,.psm1,.vbs,.vbe,.jse,.wsf,.wsh,.hta,.jar,.apk,.html,.htm,.svg

# ── 工作空间文件上传配置 ────────────────────────────────────
WORKSPACE_MAX_FILE_SIZE_MB=20
WORKSPACE_MAX_USER_STORAGE_MB=1024
WORKSPACE_ALLOWED_EXTENSIONS=.txt,.md,.py,.js,.ts,.tsx,.json,.csv,.html,.css,.yaml,.yml,.pdf,.doc,.docx,.png,.jpg,.jpeg,.webp
WORKSPACE_ANALYZE_MAX_CHARS=12000

# ── 速率限制配置 ────────────────────────────────────────────
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT_REQUESTS=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=300
CHAT_RATE_LIMIT_REQUESTS=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHARACTER_CHAT_RATE_LIMIT_REQUESTS=20
CHARACTER_CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# ── 聊天历史配置 ────────────────────────────────────────────
CHAT_HISTORY_LIMIT=24
CHARACTER_CHAT_HISTORY_LIMIT=24

# ── 数据库迁移配置 ──────────────────────────────────────────
RUN_MIGRATIONS_ON_STARTUP=false
MIGRATIONS_FAIL_FAST=true

# ── Provider 配置 ──────────────────────────────────────────
# 是否严格检查 Provider 的环境变量密钥
PROVIDER_SECRET_CHECK_STRICT=false

# 摘要模型（留空则使用默认模型）
SUMMARY_MODEL=

# ── 记忆模块配置 ────────────────────────────────────────────
# 嵌入模型提供者: fastembed / openai
MEMORY_EMBEDDING_PROVIDER=fastembed
# 向量维度（fastembed 默认 512，openai text-embedding-3-small 为 1536）
MEMORY_VECTOR_DIMENSION=512

# ── HuggingFace 配置 ───────────────────────────────────────
# 国内镜像: https://hf-mirror.com
HF_ENDPOINT=https://hf-mirror.com

# ── 性能配置 ────────────────────────────────────────────────
# 性能配置方案: eco / standard / performance
APP_PERFORMANCE_PROFILE=eco

# Worker 数量
APP_MIN_WORKERS=1
APP_MAX_WORKERS=1
UVICORN_WORKERS_MAX=1

# 内存配置（MB）
APP_MEMORY_RESERVE_MB=1536
APP_MEMORY_PER_WORKER_MB=900
APP_CPU_THREADS_PER_WORKER_MAX=4

# 线程池令牌数
API_THREADPOOL_TOKENS=16

# Uvicorn 超时配置（秒）
UVICORN_TIMEOUT=600
UVICORN_KEEPALIVE_TIMEOUT=600

# ── 启动锁文件配置 ──────────────────────────────────────────
STARTUP_INIT_LOCK_FILE=/tmp/palink_startup.lock
STARTUP_INIT_DONE_FILE=/tmp/palink_startup.done

# ── LlamaCPP 本地模型配置（可选） ──────────────────────────
# GPU 层数（0=仅CPU，-1=自动检测）
# LLAMA_N_GPU_LAYERS=-1
# 上下文大小
# LLAMA_N_CTX=4096
# 线程数
# LLAMA_N_THREADS=4

# ── 并行计算配置（可选） ────────────────────────────────────
# TOKENIZERS_PARALLELISM=false
# OMP_NUM_THREADS=
# OPENBLAS_NUM_THREADS=
# MKL_NUM_THREADS=
# NUMEXPR_NUM_THREADS=

# ── CASDOOR 认证配置（可选，也可通过管理员 UI 配置） ──────
# 启用 CASDOOR 统一登录
# CASDOOR_ENABLED=false
# CASDOOR 服务地址
# CASDOOR_ENDPOINT=https://your-casdoor-domain.com
# CASDOOR 应用 Client ID
# CASDOOR_CLIENT_ID=
# CASDOOR 应用 Client Secret
# CASDOOR_CLIENT_SECRET=
# CASDOOR 证书（PEM 格式）
# CASDOOR_CERTIFICATE=
# CASDOOR 组织名
# CASDOOR_ORGANIZATION_NAME=
# CASDOOR 应用名
# CASDOOR_APPLICATION_NAME=
# CASDOOR 回调地址
# CASDOOR_REDIRECT_URI=

# ── 本地认证配置 ──────────────────────────────────────────
# 启用本地密码登录
# LOCAL_LOGIN_ENABLED=true
# 启用本地注册
# LOCAL_REGISTER_ENABLED=true

# Palink + official SillyTavern sidecar
# Public URL used by Palink when embedding ST Native. Leave empty to derive
# http(s)://<current-host>:ST_NATIVE_PUBLIC_PORT.
ST_NATIVE_URL=
ST_NATIVE_PUBLIC_PORT=8000
# Internal Docker service URL for status/debug metadata.
ST_NATIVE_SERVICE_URL=http://sillytavern:8000
# Optional service API key. Use the same value as the API key in official
# SillyTavern's Custom/OpenAI-compatible connection when routing model calls
# through Palink /api/openai/v1.
# 安全提示（MED-5）：为空时不启用该认证分支（推荐）；若启用请设置 32+ 字符的
# 强随机串——docker 网络内任何进程持此 key 都能以 admin 身份调用 /api/openai/v1。
ST_NATIVE_SERVICE_KEY=
# Internal OpenAI-compatible URL used by the official SillyTavern sidecar.
ST_NATIVE_PALINK_OPENAI_URL=http://backend:8000/api/openai/v1
# First-run ST Native default model. palink-default resolves to the first
# available Palink model at request time.
ST_NATIVE_DEFAULT_MODEL=palink-default
# Keep official ST data under per-Palink-user folders such as
# data/palink-1 instead of the shared default-user folder.
PALINK_ST_NATIVE_USER_HEADER_ENABLED=true
