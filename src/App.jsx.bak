import React, { useState, useEffect, useRef, useCallback } from 'react';
import { 
  MessageSquare, Settings, Cpu, Send, Shield, Link as LinkIcon, 
  Loader2, LogOut, Trash2, Plus, Sliders, Users, User, ChevronDown, 
  Brain, Sun, Moon, X, Copy, Check, Eye, Server, Sparkles, 
  Edit3, RefreshCw, PanelLeftClose, PanelLeftOpen, StopCircle, 
  MoreHorizontal, AlertCircle, Upload, ToggleLeft, ToggleRight,
  Database, Globe, Key, LayoutGrid
} from 'lucide-react';
import ReactMarkdown from 'react-markdown';

/**
 * Palink AI Frontend v0.29.2 (Stream Fix Edition)
 * [FIX] 修复流式输出不实时显示的问题
 * [FIX] 添加强制渲染触发器确保 UI 实时更新
 */

// --- 0. Utils & Components ---

const convertFileToBase64 = (file) => new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.readAsDataURL(file);
    reader.onload = () => resolve(reader.result);
    reader.onerror = error => reject(error);
});

const safeParse = (key, fallback) => {
  try {
    const item = localStorage.getItem(key);
    return item ? JSON.parse(item) : fallback;
  } catch (e) {
    return fallback;
  }
};

const normalizeModel = (m) => {
  if (!m) return { id: 'unknown', alias: 'Unknown', icon: '', description: '' };
  if (typeof m === 'string') return { id: m, alias: m, icon: '', description: '' };
  return {
    id: m.id || 'unknown',
    alias: m.alias || m.name || m.id || 'Unknown',
    icon: m.icon || '', 
    description: m.description || ''
  };
};

const CodeBlock = ({ inline, className, children, ...props }) => {
  const match = /language-(\w+)/.exec(className || '');
  const [copied, setCopied] = useState(false);
  
  if (inline) {
    return <code className="bg-gray-100 dark:bg-gray-800 px-1 py-0.5 rounded text-sm font-mono text-pink-500" {...props}>{children}</code>;
  }

  return (
    <div className="relative group my-4 rounded-lg overflow-hidden border border-gray-200 dark:border-gray-700 bg-[#1e1e1e]">
      <div className="flex justify-between items-center px-4 py-2 bg-[#2d2d2d] border-b border-gray-700 text-xs text-gray-400">
        <span className="font-mono">{match ? match[1] : 'text'}</span>
        <button onClick={()=>{navigator.clipboard.writeText(String(children));setCopied(true);setTimeout(()=>setCopied(false),2000)}} className="flex items-center gap-1 hover:text-white transition-colors">
          {copied ? <Check size={12} className="text-green-400"/> : <Copy size={12}/>}
          <span>{copied ? 'Copied' : 'Copy'}</span>
        </button>
      </div>
      <pre className="p-4 overflow-x-auto text-sm font-mono text-gray-300 leading-relaxed scrollbar-thin">
        <code className={className} {...props}>{children}</code>
      </pre>
    </div>
  );
};

const ThinkingBlock = ({ content, isStreaming }) => {
  if (!content && !isStreaming) return null;

  return (
    <details open={isStreaming} className="mb-4 group bg-gray-50 dark:bg-gray-900/50 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden transition-all">
      <summary className="flex items-center gap-2 p-3 cursor-pointer select-none hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors list-none">
        <Brain size={16} className={`text-indigo-500 ${isStreaming ? 'animate-pulse' : ''}`} />
        <span className="text-sm font-medium text-gray-600 dark:text-gray-300">
          {isStreaming ? '正在深度思考...' : '思考过程'}
        </span>
        <ChevronDown size={14} className="ml-auto text-gray-400 transition-transform group-open:rotate-180" />
      </summary>
      <div className="p-4 pt-0 border-t border-gray-100 dark:border-gray-800/50 mt-2">
        <div className="text-xs text-gray-500 dark:text-gray-400 font-mono whitespace-pre-wrap leading-relaxed opacity-90 max-h-96 overflow-y-auto">
          {content}
          {isStreaming && <span className="inline-block w-1.5 h-3 bg-indigo-400 ml-1 animate-pulse align-middle" />}
        </div>
      </div>
    </details>
  );
};

class ErrorBoundary extends React.Component {
  constructor(props) { super(props); this.state = { hasError: false, error: null }; }
  static getDerivedStateFromError(error) { return { hasError: true, error }; }
  componentDidCatch(error, errorInfo) { console.error("UI Error:", error, errorInfo); }
  render() {
    if (this.state.hasError) {
      return (
        <div className="flex flex-col items-center justify-center h-screen bg-gray-50 dark:bg-gray-900 text-gray-800 dark:text-gray-200 p-4">
          <div className="p-6 bg-white dark:bg-gray-800 rounded-xl shadow-xl max-w-lg">
            <h2 className="text-xl font-bold text-red-500 mb-4"><AlertCircle size={24} className="inline mr-2"/> 界面遇到问题</h2>
            <div className="bg-gray-100 dark:bg-black p-4 rounded text-xs font-mono overflow-auto mb-4 max-h-40">{this.state.error?.toString()}</div>
            <button onClick={() => { localStorage.clear(); window.location.reload(); }} className="w-full py-2 bg-indigo-600 text-white rounded">清除缓存并恢复</button>
          </div>
        </div>
      );
    }
    return this.props.children;
  }
}

// --- 1. Chat Components ---

const MessageContent = ({ role, content, reasoning, isStreaming, modelInfo, tokens, onDelete, onRegenerate }) => {
  let displayReasoning = reasoning;
  let displayContent = content || '';

  if (!displayReasoning && content) {
    const normalized = content
      .replace(/&lt;/g, '<')
      .replace(/&gt;/g, '>')
      .replace(/&amp;/g, '&');
      
    const thinkStartTag = '<think>';
    const thinkEndTag = '</think>';
    
    const startIndex = normalized.indexOf(thinkStartTag);
    
    if (startIndex !== -1) {
      const endIndex = normalized.indexOf(thinkEndTag);
      
      if (endIndex !== -1) {
        displayReasoning = normalized.substring(startIndex + thinkStartTag.length, endIndex);
        displayContent = normalized.substring(endIndex + thinkEndTag.length).trim();
      } else if (isStreaming) {
        displayReasoning = normalized.substring(startIndex + thinkStartTag.length);
        displayContent = '';
      }
    }
  }

  // 只有当有实际思考内容时才显示思考框，避免强制显示空的思考框
  const showThinking = displayReasoning && displayReasoning.length > 0;
  const showContentCursor = isStreaming && role === 'assistant';

  return (
    <div className="w-full max-w-4xl mx-auto mb-8 group">
      <div className="flex items-center gap-3 mb-2 px-1">
        <div className={`w-8 h-8 rounded-full flex items-center justify-center text-lg shrink-0 ${role === 'user' ? 'bg-gray-200 dark:bg-gray-700' : 'bg-indigo-100 dark:bg-indigo-900/50'}`}>
          {role === 'user' ? <User size={16} className="text-gray-600 dark:text-gray-300"/> : (modelInfo?.icon?.startsWith('data') ? <img src={modelInfo.icon} className="w-full h-full object-cover rounded-full"/> : <span>{modelInfo?.icon || '🤖'}</span>)}
        </div>
        <div className="font-bold text-sm text-gray-700 dark:text-gray-200">
          {role === 'user' ? 'You' : (modelInfo?.alias || 'Assistant')}
        </div>
      </div>
      <div className="pl-11 pr-2">
        {showThinking && (
             <ThinkingBlock content={displayReasoning} isStreaming={isStreaming && !displayContent} />
        )}
        
        <div className="prose prose-slate dark:prose-invert max-w-none text-[15px] leading-7 break-words">
          {role === 'user' ? (
             <div className="whitespace-pre-wrap text-gray-800 dark:text-gray-100">{displayContent}</div>
          ) : (
            <>
              {/* 确保即使displayContent为空，也能正确渲染，特别是在流式生成时 */}
              <ReactMarkdown 
                components={{
                  code: CodeBlock,
                  a: ({href, children}) => <a href={href} target="_blank" rel="noopener noreferrer" className="text-indigo-600 hover:underline">{children}</a>
                }}
              >
                {/* 如果displayContent为空，使用一个空格作为占位符，确保ReactMarkdown能正确渲染 */}
                {displayContent || ' '}
              </ReactMarkdown>
              {/* 始终显示内容光标，直到生成完成 */}
              {showContentCursor && <span className="inline-block w-2 h-4 bg-indigo-500 ml-1 animate-pulse align-middle" />}
            </>
          )}
        </div>
        
        <div className="flex items-center justify-between mt-3 pt-2 border-t border-transparent transition-colors">
          <div className="flex items-center gap-2 text-xs text-gray-400 font-mono">
            {role === 'assistant' && tokens > 0 && <span>{tokens} tokens</span>}
          </div>
          <div className="flex gap-1">
             {role === 'assistant' && !isStreaming && (
               <button onClick={onRegenerate} className="p-1.5 hover:bg-gray-100 dark:hover:bg-gray-800 rounded text-gray-500 hover:text-indigo-600 transition-colors" title="重新生成">
                 <RefreshCw size={14}/>
               </button>
             )}
             <button onClick={onDelete} className="p-1.5 hover:bg-red-50 dark:hover:bg-red-900/20 rounded text-gray-400 hover:text-red-500 transition-colors" title="删除此条记录">
               <Trash2 size={14}/>
             </button>
          </div>
        </div>
      </div>
    </div>
  );
}

// --- 2. Admin Components ---

const ModelEditModal = ({ model, onSave, onClose }) => {
  const [data, setData] = useState(model || { id: '', alias: '', icon: '', description: '' });
  
  const handleFileUpload = async (e) => {
    const file = e.target.files[0];
    if (file) {
      try { const base64 = await convertFileToBase64(file); setData({ ...data, icon: base64 }); } catch (err) { alert('图片上传失败'); }
    }
  };

  return (
    <div className="fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] flex items-center justify-center p-4 animate-in fade-in duration-200">
      <div className="bg-white dark:bg-gray-900 w-full max-w-lg rounded-2xl shadow-2xl border dark:border-gray-700 flex flex-col overflow-hidden">
        <div className="p-4 border-b dark:border-gray-800 flex justify-between items-center bg-gray-50 dark:bg-gray-800/50">
          <h3 className="font-bold text-lg dark:text-white">编辑模型</h3>
          <button onClick={onClose}><X size={20} className="text-gray-500"/></button>
        </div>
        <div className="p-6 space-y-4">
          <div className="flex items-center gap-4">
            <div className="w-16 h-16 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center border dark:border-gray-700 overflow-hidden relative group cursor-pointer">
              {data.icon && data.icon.length > 5 ? <img src={data.icon} className="w-full h-full object-cover"/> : <span className="text-2xl">{data.icon || '🤖'}</span>}
              <label className="absolute inset-0 bg-black/50 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                <Upload size={20} className="text-white"/>
                <input type="file" className="hidden" accept="image/*" onChange={handleFileUpload} />
              </label>
            </div>
            <div className="flex-1 space-y-1">
              <label className="text-[10px] font-bold text-gray-400 uppercase">模型 ID</label>
              <input value={data.id} onChange={e=>setData({...data, id:e.target.value})} className="w-full bg-gray-50 dark:bg-gray-800 border dark:border-gray-700 p-2 rounded text-sm font-mono" placeholder="gpt-4o"/>
            </div>
          </div>
          <div className="space-y-1">
            <label className="text-[10px] font-bold text-gray-400 uppercase">显示名称</label>
            <input value={data.alias} onChange={e=>setData({...data, alias:e.target.value})} className="w-full bg-gray-50 dark:bg-gray-800 border dark:border-gray-700 p-2 rounded text-sm" placeholder="GPT-4 Omni"/>
          </div>
          <div className="space-y-1">
            <label className="text-[10px] font-bold text-gray-400 uppercase">头像 Emoji (可选,如果未上传图片)</label>
            <input value={data.icon} onChange={e=>setData({...data, icon:e.target.value})} className="w-full bg-gray-50 dark:bg-gray-800 border dark:border-gray-700 p-2 rounded text-sm" placeholder="🤖"/>
          </div>
          <div className="space-y-1">
            <label className="text-[10px] font-bold text-gray-400 uppercase">简介</label>
            <textarea value={data.description} onChange={e=>setData({...data, description:e.target.value})} className="w-full bg-gray-50 dark:bg-gray-800 border dark:border-gray-700 p-2 rounded text-sm h-20 resize-none" placeholder="简介..."/>
          </div>
        </div>
        <div className="p-4 border-t dark:border-gray-800 flex justify-end gap-2 bg-gray-50 dark:bg-gray-900">
          <button onClick={onClose} className="px-4 py-2 text-sm text-gray-600 hover:bg-gray-200 rounded-lg">取消</button>
          <button onClick={()=>onSave(data)} className="px-6 py-2 text-sm bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">保存</button>
        </div>
      </div>
    </div>
  );
};

const ModelListEditor = ({ models, onChange }) => {
  const [editingIdx, setEditingIdx] = useState(null);
  const safeModels = (Array.isArray(models) ? models : []).map(normalizeModel);

  return (
    <div className="space-y-3">
      <div className="flex flex-col gap-2">
        {safeModels.map((m, i) => (
          <div key={i} className="flex items-center gap-3 bg-white dark:bg-gray-800 p-2 px-3 rounded-lg border dark:border-gray-700 shadow-sm group">
            <div className="w-8 h-8 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center text-lg overflow-hidden shrink-0">
              {m.icon?.startsWith('data:image') ? <img src={m.icon} className="w-full h-full object-cover" /> : <span>{m.icon || '🤖'}</span>}
            </div>
            <div className="flex-1 overflow-hidden">
               <div className="flex items-center gap-2">
                 <span className="font-bold text-sm dark:text-gray-200">{m.alias}</span>
                 <span className="text-[10px] text-gray-400 bg-gray-50 dark:bg-gray-900 px-1 rounded font-mono">{m.id}</span>
               </div>
            </div>
            <div className="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
              <button onClick={()=>setEditingIdx(i)} className="p-1.5 hover:bg-indigo-50 text-indigo-500 rounded"><Edit3 size={14}/></button>
              <button onClick={()=>{const n=[...safeModels];n.splice(i,1);onChange(n)}} className="p-1.5 hover:bg-red-50 text-red-500 rounded"><Trash2 size={14}/></button>
            </div>
          </div>
        ))}
        <button onClick={()=>setEditingIdx(-1)} className="w-full py-2 border border-dashed border-gray-300 dark:border-gray-700 rounded-lg text-xs text-gray-500 hover:text-indigo-500 hover:border-indigo-400 transition-colors flex justify-center items-center gap-1">
          <Plus size={14}/> 添加模型
        </button>
      </div>
      {editingIdx !== null && (
        <ModelEditModal 
          model={editingIdx === -1 ? null : safeModels[editingIdx]} 
          onClose={()=>setEditingIdx(null)}
          onSave={(newModel) => {
            const n = [...safeModels];
            if (editingIdx === -1) n.push(newModel);
            else n[editingIdx] = newModel;
            onChange(n);
            setEditingIdx(null);
          }}
        />
      )}
    </div>
  );
};

const AdminPanel = ({ token, onLogout, onProvidersChange }) => {
  const [activeTab, setActiveTab] = useState('models');
  const [providers, setProviders] = useState([]);
  const [users, setUsers] = useState([]);
  const [settings, setSettings] = useState({});
  const [loading, setLoading] = useState(false);
  const [isAddingProvider, setIsAddingProvider] = useState(false);
  const [editingProvider, setEditingProvider] = useState(null);
  const [inspectUser, setInspectUser] = useState(null);
  const [userSessions, setUserSessions] = useState([]);
  const [inspectSessionId, setInspectSessionId] = useState(null);
  const [sessionMessages, setSessionMessages] = useState([]);

  const headers = { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' };
  const fetchSafe = useCallback(async (url, opt={}) => { 
    try {
        const res = await fetch(url, {...opt, headers: {...headers, ...opt.headers}}); 
        if (res.status === 401) { onLogout(); return null; }
        return res.json();
    } catch (e) { console.error(e); return null; }
  }, [token, onLogout]);

  useEffect(() => { 
    const load = async () => {
        setLoading(true);
        if(activeTab === 'models') setProviders(await fetchSafe('/api/admin/providers') || []);
        if(activeTab === 'users') setUsers(await fetchSafe('/api/admin/users') || []);
        if(activeTab === 'settings') setSettings(await fetchSafe('/api/admin/settings') || {});
        setLoading(false);
    };
    load();
  }, [activeTab, fetchSafe]);

  const saveProviders = async (newData) => {
    setProviders(newData);
    await fetch('/api/admin/providers', { method: 'POST', headers, body: JSON.stringify(newData) });
    if (onProvidersChange) onProvidersChange();
  };

  const handleSaveProvider = async (p) => {
      let newProviders = [...providers];
      const idx = newProviders.findIndex(x => x.id === p.id);
      if (idx >= 0) newProviders[idx] = p;
      else newProviders.push(p);
      await saveProviders(newProviders);
      setIsAddingProvider(false); setEditingProvider(null);
  };

  const deleteUser = async (uid) => {
      if(!confirm("确认删除该用户?")) return;
      await fetchSafe(`/api/admin/users/${uid}`, {method:'DELETE'});
      setUsers(prev => prev.filter(u => u.id !== uid));
  };

  const toggleRegister = async () => {
      const newVal = settings.allow_register !== 'true';
      await fetch('/api/admin/settings', { method: 'POST', headers, body: JSON.stringify({ allow_register: newVal }) });
      setSettings(prev => ({...prev, allow_register: String(newVal)}));
  };

  const openInspector = async (u) => {
      setInspectUser(u);
      const s = await fetchSafe(`/api/admin/users/${u.id}/sessions`);
      setUserSessions(s || []);
      setInspectSessionId(null);
      setSessionMessages([]);
  };

  const loadInspectorSession = async (sid) => {
      setInspectSessionId(sid);
      const m = await fetchSafe(`/api/admin/sessions/${sid}/messages`);
      setSessionMessages(m || []);
  };

  const CHANNEL_PRESETS = [
    { id: 'deepseek', name: 'DeepSeek', base_url: 'https://api.deepseek.com', icon: '🦈' },
    { id: 'doubao', name: '豆包 (Volcengine)', base_url: 'https://ark.cn-beijing.volces.com/api/v3', icon: '🐲' },
    { id: 'openrouter', name: 'OpenRouter', base_url: 'https://openrouter.ai/api/v1', icon: '🌍' },
    { id: 'openai', name: 'OpenAI', base_url: 'https://api.openai.com/v1', icon: '🟢' },
  ];

  return (
    <div className="h-full flex flex-col bg-gray-50 dark:bg-gray-900">
      <div className="bg-white dark:bg-black border-b dark:border-gray-800 px-6 py-4 flex items-center justify-between">
        <h2 className="text-xl font-bold flex items-center gap-2 text-gray-800 dark:text-white">
          <Shield className="text-indigo-600"/> 管理后台
        </h2>
        <div className="flex gap-1 bg-gray-100 dark:bg-gray-800 p-1 rounded-lg">
          {['models', 'users', 'settings'].map(t => (
            <button key={t} onClick={()=>setActiveTab(t)} className={`px-4 py-1.5 rounded-md text-sm font-medium transition-all ${activeTab===t ? 'bg-white dark:bg-gray-700 shadow text-indigo-600 dark:text-white' : 'text-gray-500 hover:text-gray-800 dark:hover:text-gray-300'}`}>
              {t === 'models' ? '模型渠道' : t === 'users' ? '用户管理' : '系统设置'}
            </button>
          ))}
        </div>
      </div>

      <div className="flex-1 overflow-y-auto p-8 w-full relative">
        {loading && <div className="absolute inset-0 flex items-center justify-center bg-white/50 dark:bg-black/50 z-10"><Loader2 className="animate-spin text-indigo-600"/></div>}
        
        <div className="max-w-5xl mx-auto">
            {activeTab === 'models' && (
              <div className="space-y-8">
                <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                  <button onClick={()=>{setEditingProvider({id:`p-${Date.now()}`,name:'New Provider',base_url:'',api_key:'',models:[],is_active:true});setIsAddingProvider(true)}} className="flex flex-col items-center justify-center gap-2 p-4 border-2 border-dashed border-gray-300 dark:border-gray-700 hover:border-indigo-500 hover:text-indigo-500 rounded-xl transition-all text-gray-400 h-full min-h-[100px]">
                      <Plus size={24}/>
                      <span className="text-xs font-bold">自定义渠道</span>
                  </button>
                  {CHANNEL_PRESETS.map(p => (
                    <button key={p.id} onClick={()=>{setEditingProvider({id:`p-${Date.now()}`,name:p.name,base_url:p.base_url,api_key:'',models:[],is_active:true});setIsAddingProvider(true)}} className="flex flex-col items-center gap-2 p-4 bg-white dark:bg-gray-800 border dark:border-gray-700 hover:border-indigo-500 hover:shadow-md rounded-xl transition-all group">
                      <span className="text-3xl group-hover:scale-110 transition-transform">{p.icon}</span>
                      <span className="text-sm font-medium text-gray-700 dark:text-gray-300">{p.name}</span>
                    </button>
                  ))}
                </div>
                {providers.map((p, pIdx) => (
                  <div key={p.id} className="bg-white dark:bg-gray-800 rounded-xl border dark:border-gray-700 shadow-sm overflow-hidden">
                    <div className="p-4 bg-gray-50 dark:bg-gray-800/50 border-b dark:border-gray-700 flex items-center gap-4">
                      <div className="p-2 bg-indigo-100 dark:bg-indigo-900/30 rounded-lg"><Server size={18} className="text-indigo-600"/></div>
                      <div className="font-bold text-lg dark:text-white">{p.name}</div>
                      <div className="ml-auto flex items-center gap-2">
                         <button onClick={()=>{const n=[...providers]; n[pIdx].is_active=!n[pIdx].is_active; saveProviders(n);}} className={`px-2 py-1 text-xs rounded font-bold ${p.is_active?'bg-green-100 text-green-700':'bg-gray-200 text-gray-500'}`}>{p.is_active?'已启用':'已停用'}</button>
                         <button onClick={()=>{setEditingProvider(p); setIsAddingProvider(true);}} className="p-2 text-indigo-500 hover:bg-indigo-50 rounded-lg"><Edit3 size={16}/></button>
                         <button onClick={()=>{if(confirm('删除此渠道?')) saveProviders(providers.filter((_,i)=>i!==pIdx))}} className="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg"><Trash2 size={16}/></button>
                      </div>
                    </div>
                    <div className="p-4 flex flex-wrap gap-2">
                        {p.models && p.models.length > 0 ? p.models.map(normalizeModel).map((m, i) => (
                            <div key={i} className="flex items-center gap-1.5 bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded text-xs text-gray-700 dark:text-gray-300">
                                <span>{m.icon || '🤖'}</span>
                                <span className="font-bold">{m.alias}</span>
                            </div>
                        )) : <span className="text-xs text-gray-400 italic">暂无模型配置</span>}
                    </div>
                  </div>
                ))}
              </div>
            )}
            {activeTab === 'users' && (
              <div className="space-y-6">
                 <div className="grid gap-4">
                    {users.map(u => (
                        <div key={u.id} className="bg-white dark:bg-gray-800 p-4 rounded-xl border dark:border-gray-700 flex items-center justify-between">
                            <div className="flex items-center gap-4">
                                <div className="w-10 h-10 rounded-full bg-indigo-100 dark:bg-indigo-900 flex items-center justify-center font-bold text-indigo-600 dark:text-indigo-300">
                                    {u.username[0].toUpperCase()}
                                </div>
                                <div>
                                    <div className="font-bold dark:text-white">{u.username}</div>
                                    <div className="text-xs text-gray-500">ID: {u.id} • {u.role.toUpperCase()}</div>
                                </div>
                            </div>
                            <div className="flex gap-2">
                                <button onClick={()=>openInspector(u)} className="flex items-center gap-1 px-3 py-1.5 bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 rounded-lg text-xs font-bold hover:bg-indigo-100 transition-colors"><Eye size={14}/> 审计会话</button>
                                <button onClick={()=>deleteUser(u.id)} className="p-2 text-red-400 hover:text-red-600 hover:bg-red-50 rounded-lg"><Trash2 size={16}/></button>
                            </div>
                        </div>
                    ))}
                 </div>
              </div>
            )}
            {activeTab === 'settings' && (
              <div className="max-w-2xl mx-auto">
                 <div className="bg-white dark:bg-gray-800 p-6 rounded-2xl border dark:border-gray-700 flex items-center justify-between">
                     <div>
                         <h3 className="font-bold text-lg dark:text-white flex items-center gap-2"><Users size={20}/> 开放注册</h3>
                         <p className="text-sm text-gray-500 mt-1">允许外部访客注册新账号。关闭后仅管理员可添加用户。</p>
                     </div>
                     <button onClick={toggleRegister} className={`text-4xl transition-colors ${settings.allow_register==='true'?'text-green-500':'text-gray-300'}`}>
                         {settings.allow_register==='true' ? <ToggleRight size={48}/> : <ToggleLeft size={48}/>}
                     </button>
                 </div>
              </div>
            )}
        </div>
      </div>
      
      {isAddingProvider && (
        <div className="fixed inset-0 bg-black/60 backdrop-blur-md z-50 flex items-center justify-center p-4 animate-in fade-in duration-200">
           <div className="bg-white dark:bg-gray-900 w-full max-w-2xl rounded-3xl shadow-2xl border dark:border-gray-700 flex flex-col max-h-[90vh] overflow-hidden">
              <div className="p-6 border-b dark:border-gray-800 flex justify-between items-center bg-gray-50 dark:bg-gray-900/50">
                 <h3 className="font-bold text-xl flex items-center gap-2 dark:text-white"><Sparkles className="text-indigo-500"/> 配置 AI 渠道</h3>
                 <button onClick={() => setIsAddingProvider(false)} className="text-gray-400 hover:text-gray-600"><X size={24}/></button>
              </div>
              <div className="p-6 overflow-y-auto space-y-6">
                 <div className="grid grid-cols-2 gap-4">
                    <div>
                        <label className="text-[10px] font-bold text-gray-400 uppercase">渠道名称</label>
                        <input value={editingProvider?.name||''} onChange={e=>setEditingProvider({...editingProvider, name:e.target.value})} className="w-full bg-gray-50 dark:bg-gray-800 border dark:border-gray-700 p-3 rounded-xl outline-none dark:text-white" />
                    </div>
                    <div>
                        <label className="text-[10px] font-bold text-gray-400 uppercase">API Key</label>
                        <input value={editingProvider?.api_key||''} onChange={e=>setEditingProvider({...editingProvider, api_key:e.target.value})} type="password" className="w-full bg-gray-50 dark:bg-gray-800 border dark:border-gray-700 p-3 rounded-xl outline-none dark:text-white" placeholder="sk-..." />
                    </div>
                    <div className="col-span-2">
                        <label className="text-[10px] font-bold text-gray-400 uppercase">Base URL</label>
                        <input value={editingProvider?.base_url||''} onChange={e=>setEditingProvider({...editingProvider, base_url:e.target.value})} className="w-full bg-gray-50 dark:bg-gray-800 border dark:border-gray-700 p-3 rounded-xl outline-none font-mono text-sm dark:text-white" />
                    </div>
                 </div>
                 <div className="border-t dark:border-gray-800 pt-6">
                    <label className="text-sm font-bold block mb-4 dark:text-white">模型库管理</label>
                    <ModelListEditor models={editingProvider?.models} onChange={m=>setEditingProvider({...editingProvider, models:m})}/>
                 </div>
              </div>
              <div className="p-6 border-t dark:border-gray-800 flex justify-end gap-3">
                 <button onClick={() => setIsAddingProvider(false)} className="px-6 py-2.5 rounded-xl font-bold hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800">取消</button>
                 <button onClick={() => handleSaveProvider(editingProvider)} className="px-10 py-2.5 bg-indigo-600 text-white rounded-xl font-bold shadow-lg shadow-indigo-500/20">保存配置</button>
              </div>
           </div>
        </div>
      )}
      
      {inspectUser && (
        <div className="fixed inset-0 bg-black/60 backdrop-blur-md z-50 flex items-center justify-center p-4 animate-in fade-in duration-200">
           <div className="bg-white dark:bg-gray-900 w-full max-w-6xl h-[85vh] rounded-3xl shadow-2xl border dark:border-gray-700 flex flex-col overflow-hidden">
               <div className="p-4 border-b dark:border-gray-800 flex justify-between items-center bg-gray-50 dark:bg-gray-900">
                  <h3 className="font-bold flex items-center gap-2 text-gray-800 dark:text-white">
                      <Eye size={18} className="text-indigo-500"/> 审计模式: <span className="text-indigo-600">{inspectUser.username}</span>
                  </h3>
                  <button onClick={()=>setInspectUser(null)} className="text-gray-500 hover:text-gray-800"><X size={20}/></button>
               </div>
               <div className="flex-1 flex overflow-hidden">
                  <div className="w-72 border-r dark:border-gray-800 overflow-y-auto p-2 bg-gray-50 dark:bg-black/20">
                      {userSessions.length === 0 && <div className="text-center p-4 text-gray-400 text-xs">该用户暂无会话</div>}
                      {userSessions.map(s=>(
                          <div key={s.id} onClick={()=>loadInspectorSession(s.id)} className={`p-3 rounded-xl text-sm cursor-pointer mb-2 transition-all ${inspectSessionId===s.id?'bg-indigo-600 text-white shadow-md':'hover:bg-gray-200 dark:hover:bg-gray-800 dark:text-gray-300'}`}>
                              <div className="font-bold truncate">{s.title}</div>
                              <div className="text-[10px] opacity-70 mt-1">{new Date(s.updated_at).toLocaleString()}</div>
                          </div>
                      ))}
                  </div>
                  <div className="flex-1 overflow-y-auto p-6 bg-gray-100 dark:bg-[#0c0c0c] space-y-6">
                      {sessionMessages.length === 0 ? (
                          <div className="h-full flex items-center justify-center text-gray-400">选择左侧会话以查看详情</div>
                      ) : (
                          sessionMessages.map((m,i)=>(
                              <div key={i} className={`flex ${m.role==='user'?'justify-end':'justify-start'}`}>
                                  <div className={`max-w-[80%] rounded-2xl p-4 text-sm shadow-sm ${m.role==='user'?'bg-indigo-600 text-white':'bg-white dark:bg-gray-800 dark:text-gray-200 border dark:border-gray-700'}`}>
                                      <div className="mb-1 flex justify-between text-[10px] opacity-50 font-bold uppercase tracking-wider">
                                          <span>{m.role}</span>
                                          <span>{m.model}</span>
                                      </div>
                                      <div className="whitespace-pre-wrap">{m.content}</div>
                                  </div>
                              </div>
                          ))
                      )}
                  </div>
               </div>
           </div>
        </div>
      )}
    </div>
  );
};

// --- 3. Chat Module (Core) ---
const ChatModule = ({ token, onLogout, refreshTrigger }) => {
  // 重新设计状态管理，确保AI回复能实时显示
  const [sessionsData, setSessionsData] = useState({});
  const [currentMsgs, setCurrentMsgs] = useState([]);
  const [sessions, setSessions] = useState([]);
  const [curSessionId, setCurSessionId] = useState(null);
  const [generatingSessions, setGeneratingSessions] = useState(new Set()); 
  const [input, setInput] = useState('');
  const [isSidebarOpen, setIsSidebarOpen] = useState(true);
  const [availableModels, setAvailableModels] = useState([]);
  const [loadingModels, setLoadingModels] = useState(true);
  const [settings, setSettings] = useState(() => safeParse('palink_chat_settings', { model: '', temp: 0.7 }));
  const [isModelDropdownOpen, setIsModelDropdownOpen] = useState(false);
  // 添加渲染触发器，确保每个字符更新都能触发重渲染
  const [renderTrigger, setRenderTrigger] = useState(0);
  // 使用useCallback优化函数，避免不必要的重渲染
  const forceRender = useCallback(() => {
    setRenderTrigger(prev => prev + 1);
  }, []);

  const abortControllers = useRef({});
  const messagesEndRef = useRef(null);
  const chatContainerRef = useRef(null);
  const shouldAutoScroll = useRef(true);

  const headers = { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' };
  const fetchSafe = useCallback(async (url, opt={}) => { 
    const res = await fetch(url, { ...opt, headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json', ...opt.headers } }); 
    if (res.status === 401) { onLogout(); throw new Error("401"); } 
    // 确保只返回成功的响应，否则抛出错误
    if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);
    return res; 
  }, [token, onLogout]);

  useEffect(() => {
    return () => {
      Object.values(abortControllers.current).forEach(c => c.abort());
    };
  }, []);

  const loadModels = useCallback(async () => {
    try {
      setLoadingModels(true);
      const res = await fetch('/api/models');
      if (res.ok) {
        const data = await res.json();
        const normalized = data.map(m => normalizeModel(m));
        setAvailableModels(normalized);
        
        if (!settings.model && normalized.length > 0) {
          setSettings(s => ({...s, model: normalized[0].id}));
        }
        
        console.log('✅ 已加载', normalized.length, '个模型');
      } else {
        console.error('❌ 加载模型失败:', res.status);
      }
    } catch (err) {
      console.error('❌ 加载模型异常:', err);
    } finally {
      setLoadingModels(false);
    }
  }, [settings.model]);

  useEffect(() => {
    loadModels();
    
    fetchSafe('/api/sessions')
      .then(r => r.json())
      .then(d => {
        // 确保sessions始终是数组类型
        const sessionsArray = Array.isArray(d) ? d : [];
        setSessions(sessionsArray);
        if (sessionsArray.length > 0) setCurSessionId(sessionsArray[0].id);
      })
      .catch(() => {
        // 出错时确保sessions是数组
        setSessions([]);
      });
  }, [refreshTrigger]);

  useEffect(() => {
    if (curSessionId) {
       // 检查当前对话是否正在生成中，如果是，则不中断它，也不拉取历史记录
       // 这样可以保持流式生成的连续性，避免切换对话后回到该对话时覆盖正在生成的内容
       if (generatingSessions.has(curSessionId)) {
         console.log('[Session Switch] Session', curSessionId, 'is generating, preserving current state');
         // 如果当前对话正在生成，只确保currentMsgs是最新的
         if (sessionsData[curSessionId]) {
           setCurrentMsgs(sessionsData[curSessionId]);
         }
       } else {
         // 如果当前对话没有在生成，则拉取历史记录
         fetchSafe(`/api/sessions/${curSessionId}/messages`)
           .then(r=>r.json())
           .then(msgs => {
             setSessionsData(prev => ({ ...prev, [curSessionId]: msgs }));
             setCurrentMsgs(msgs);
             setTimeout(()=>scrollToBottom(true), 100);
           });
       }
    }
  }, [curSessionId]);

  const scrollToBottom = (force = false) => {
    if (shouldAutoScroll.current || force) {
      requestAnimationFrame(() => {
        messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
      });
    }
  };

  const handleScroll = () => {
    if (!chatContainerRef.current) return;
    const { scrollTop, scrollHeight, clientHeight } = chatContainerRef.current;
    shouldAutoScroll.current = (scrollHeight - scrollTop - clientHeight < 100);
  };

  // 彻底重写的sendMessage函数，实现真正的流式实时显示
  const sendMessage = async () => {
    if (!input.trim() || !curSessionId) return;
    
    if (!settings.model) {
      alert('⚠️ 请先在右上角选择一个模型');
      return;
    }
    
    const targetSessionId = curSessionId;
    const userText = input;
    const modelToUse = settings.model;
    const modelInfo = availableModels.find(m => m.id === modelToUse);
    
    if (!modelInfo) {
      alert('⚠️ 当前选择的模型不可用,请重新选择');
      return;
    }
    
    setInput('');
    scrollToBottom(true);
    
    // 生成唯一的消息ID
    const timestamp = Date.now();
    const random = Math.floor(Math.random() * 10000);
    const userMsgId = `user-${timestamp}-${random}`;
    const assistantMsgId = `assistant-${timestamp}-${random}`;
    
    // 创建新消息
    const now = Date.now();
    const newUserMsg = { id: userMsgId, role: 'user', content: userText, lastUpdated: now };
    const newAssistantMsg = { 
      id: assistantMsgId, 
      role: 'assistant', 
      content: '', 
      reasoning: '', 
      isStreaming: true, 
      lastUpdated: now,
      ...modelInfo 
    };
    
    // 确保currentMsgs是数组，避免扩展运算符出错
    const currentMsgsArray = Array.isArray(currentMsgs) ? currentMsgs : [];
    const updatedMsgs = [...currentMsgsArray, newUserMsg, newAssistantMsg];
    setSessionsData(prev => ({ ...prev, [targetSessionId]: updatedMsgs }));
    setCurrentMsgs(updatedMsgs);
    
    setGeneratingSessions(prev => new Set(prev).add(targetSessionId));
    
    // 中断之前的请求
    if (abortControllers.current[targetSessionId]) {
      abortControllers.current[targetSessionId].abort();
    }
    
    const controller = new AbortController();
    abortControllers.current[targetSessionId] = controller;

    try {
      console.log('[SEND_MESSAGE] Starting streaming request...');
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers,
        body: JSON.stringify({ 
          session_id: targetSessionId, 
          message: userText, 
          model: modelToUse 
        }),
        signal: controller.signal
      });
      
      if (!res.ok) {
        const errorText = await res.text();
        console.error('[SEND_MESSAGE] API Error:', res.status, res.statusText, errorText);
        throw new Error(`${res.status} ${res.statusText}: ${errorText}`);
      }
      
      console.log('[SEND_MESSAGE] Streaming response received, starting to process chunks...');
      const reader = res.body.getReader();
      const decoder = new TextDecoder('utf-8');
      
      let fullText = '';
      let fullReasoning = '';
      let buffer = '';
      
      // 逐个字符处理，实现真正的实时显示
      while (true) {
        const { value, done } = await reader.read();
        
        // 解码当前接收到的字符
        if (value) {
          const chunk = decoder.decode(value, { stream: true });
          buffer += chunk;
        }
        
        // 处理所有完整的SSE事件，每个事件以\n\n分隔
        while (buffer.includes('\n\n')) {
          const eventEnd = buffer.indexOf('\n\n');
          const event = buffer.slice(0, eventEnd);
          buffer = buffer.slice(eventEnd + 2);
          
          // 只处理data:开头的行
          const dataLines = event.split('\n').filter(line => line.trim().startsWith('data:'));
          
          for (const dataLine of dataLines) {
            if (dataLine === 'data: [DONE]') continue;
            
            const cleanLine = dataLine.replace(/^data:\s*/, '').trim();
            if (!cleanLine) continue;
            
            try {
              const json = JSON.parse(cleanLine);
              console.log('[SEND_MESSAGE] Processing JSON chunk:', {
                type: json.type,
                chunk: json.chunk ? json.chunk.substring(0, 20) + (json.chunk.length > 20 ? '...' : '') : undefined,
                done: json.done
              });
              
              // 更新fullText和fullReasoning
              if (json.type === 'reasoning' && json.chunk) {
                fullReasoning += json.chunk;
                console.log('[SEND_MESSAGE] Updated reasoning:', fullReasoning.length, 'chars');
              } else if (json.type === 'content' && json.chunk) {
                fullText += json.chunk;
                console.log('[SEND_MESSAGE] Updated content:', fullText.length, 'chars');
              } else if (json.chunk) {
                // 兼容没有type字段的情况
                fullText += json.chunk;
                console.log('[SEND_MESSAGE] Updated content (no type):', fullText.length, 'chars');
              }
              
              // 立即更新状态，实现实时显示 - 确保每个字符都能触发重渲染
              setCurrentMsgs(prev => {
                const newMsgs = [...prev];
                const assistantMsgIndex = newMsgs.findIndex(msg => msg.id === assistantMsgId);
                if (assistantMsgIndex !== -1) {
                  // 创建全新的消息对象，确保React能检测到变化
                  newMsgs[assistantMsgIndex] = {
                    ...newMsgs[assistantMsgIndex],
                    content: fullText,
                    reasoning: fullReasoning,
                    isStreaming: !json.done,
                    tokens: json.done ? json.tokens || 0 : newMsgs[assistantMsgIndex].tokens,
                    // 添加渲染时间戳，确保对象引用变化
                    lastUpdated: Date.now()
                  };
                }
                return newMsgs;
              });
              
              // 同时更新sessionsData - 确保数据一致性
              setSessionsData(prev => {
                const sessionMsgs = [...(prev[targetSessionId] || [])];
                const assistantMsgIndex = sessionMsgs.findIndex(msg => msg.id === assistantMsgId);
                if (assistantMsgIndex !== -1) {
                  sessionMsgs[assistantMsgIndex] = {
                    ...sessionMsgs[assistantMsgIndex],
                    content: fullText,
                    reasoning: fullReasoning,
                    isStreaming: !json.done,
                    tokens: json.done ? json.tokens || 0 : sessionMsgs[assistantMsgIndex].tokens,
                    lastUpdated: Date.now()
                  };
                }
                return {
                  ...prev,
                  [targetSessionId]: sessionMsgs
                };
              });
              
              // 使用forceRender确保React重渲染
              forceRender();
              
              // 实时滚动
              requestAnimationFrame(() => scrollToBottom());
              
            } catch (e) {
              console.error('JSON解析错误:', e, '行:', cleanLine);
              // 出错时也强制渲染，确保错误信息显示
              forceRender();
            }
          }
        }
        
        // 只有当done为true且buffer已处理完所有完整事件时才退出循环
        if (done) {
          console.log('[SEND_MESSAGE] Streaming done, final buffer remaining:', buffer);
          break;
        }
      }
      
    } catch (err) {
      if (err.name !== 'AbortError') {
        console.error('[SEND_MESSAGE] Request Error:', err);
        // 更新错误信息
        setCurrentMsgs(prev => {
          // 确保prev是数组
          const prevArray = Array.isArray(prev) ? prev : [];
          return prevArray.map(msg => {
            if (msg.id === assistantMsgId) {
              return {
                ...msg,
                isStreaming: false,
                content: msg.content + `\n\n[错误: ${err.message}]`,
                lastUpdated: Date.now()
              };
            }
            return msg;
          });
        });
        
        setSessionsData(prev => {
          const sessionMsgs = prev[targetSessionId] || [];
          return {
            ...prev,
            [targetSessionId]: sessionMsgs.map(msg => {
              if (msg.id === assistantMsgId) {
                return {
                  ...msg,
                  isStreaming: false,
                  content: msg.content + `\n\n[错误: ${err.message}]`,
                  lastUpdated: Date.now()
                };
              }
              return msg;
            })
          };
        });
        
        // 强制渲染，确保错误信息显示
        forceRender();
      } else {
        console.log('[SEND_MESSAGE] Generation aborted by user');
      }
    } finally {
      console.log('[SEND_MESSAGE] Cleaning up resources...');
      setGeneratingSessions(prev => {
        const next = new Set(prev);
        next.delete(targetSessionId);
        return next;
      });
      delete abortControllers.current[targetSessionId];
      // 确保生成状态已更新
      forceRender();
    }
  };

  const stopGeneration = () => { if (curSessionId && abortControllers.current[curSessionId]) abortControllers.current[curSessionId].abort(); };
  const deleteMessage = async (msgId) => {
    if(!confirm("确认删除?")) return;
    setSessionsData(prev => {
      // 确保当前会话的消息是数组
      const currentMsgs = Array.isArray(prev[curSessionId]) ? prev[curSessionId] : [];
      const updatedMsgs = currentMsgs.filter(m => m.id !== msgId);
      setCurrentMsgs(updatedMsgs);
      return {...prev, [curSessionId]: updatedMsgs};
    });
    await fetchSafe(`/api/messages/${msgId}`, { method: 'DELETE' });
  };
  const createSession = async () => {
      const tempId = 'temp-'+Date.now();
      // 确保sessions是数组，避免扩展运算符出错
      const currentSessions = Array.isArray(sessions) ? sessions : [];
      setSessions([{ id: tempId, title: '新对话' }, ...currentSessions]);
      setCurSessionId(tempId);
      
      try {
          const res = await fetchSafe('/api/sessions', { 
            method: 'POST', 
            body: JSON.stringify({ title: '新对话' }) 
          });
          const realSession = await res.json();
          
          setSessions(prev => {
            // 确保prev是数组
            const prevArray = Array.isArray(prev) ? prev : [];
            return prevArray.map(s => s.id === tempId ? realSession : s);
          });
          setCurSessionId(realSession.id);
      } catch (e) {
          console.error('创建会话失败:', e);
          setSessions(prev => {
            // 确保prev是数组
            const prevArray = Array.isArray(prev) ? prev : [];
            return prevArray.filter(s => s.id !== tempId);
          });
          // 出错后重置currentMsgs
          setCurrentMsgs([]);
      }
  };
  const deleteSession = async (sessId, e) => {
    e.stopPropagation(); if(!confirm("删除会话?")) return;
    // 确保sessions是数组，避免filter方法出错
    const currentSessions = Array.isArray(sessions) ? sessions : [];
    const nextSessions = currentSessions.filter(s => s.id !== sessId);
    setSessions(nextSessions);
    if (sessId === curSessionId) setCurSessionId(nextSessions.length > 0 ? nextSessions[0].id : null);
    await fetchSafe(`/api/sessions/${sessId}`, { method: 'DELETE' });
  };

  const currentModelInfo = availableModels.find(m => m.id === settings.model) || { alias: '选择模型', icon: '🤖' };

  return (
    <div className="flex h-full relative">
      <div className={`flex-shrink-0 bg-gray-50 dark:bg-[#0c0c0c] border-r dark:border-gray-800 flex flex-col transition-all duration-300 ${isSidebarOpen ? 'w-72' : 'w-0'} overflow-hidden`}>
        <div className="w-72 h-full flex flex-col">
           <div className="p-4 space-y-2">
             <button onClick={createSession} className="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-xl flex justify-center items-center gap-2 transition-all font-bold shadow-md shadow-indigo-500/20">
               <Plus size={18}/> 开启新话题
             </button>
           </div>
           <div className="flex-1 overflow-y-auto px-3 space-y-1 py-2">
              {sessions.map(s => (
                  <div key={s.id} onClick={() => setCurSessionId(s.id)} className={`group relative p-3 rounded-xl text-sm cursor-pointer transition-all flex items-center justify-between ${curSessionId === s.id ? 'bg-white dark:bg-gray-800 shadow-sm border border-gray-200 dark:border-gray-700 font-medium' : 'text-gray-500 hover:bg-gray-200 dark:hover:bg-gray-800'}`}>
                      <div className="truncate flex-1 pr-2 dark:text-gray-300">{s.title}</div>
                      <div className="flex items-center gap-1">
                        {generatingSessions.has(s.id) && <Loader2 size={12} className="animate-spin text-indigo-500"/>}
                        <button onClick={(e) => deleteSession(s.id, e)} className="opacity-0 group-hover:opacity-100 p-1.5 hover:bg-red-100 dark:hover:bg-red-900/30 text-red-500 rounded transition-opacity"><Trash2 size={13}/></button>
                      </div>
                  </div>
              ))}
           </div>
        </div>
      </div>
      
      <div className="flex-1 flex flex-col relative overflow-hidden bg-white dark:bg-black">
        <header className="h-16 border-b dark:border-gray-800 flex items-center justify-between px-4 bg-white/80 dark:bg-black/80 backdrop-blur-md z-20 shrink-0">
           <div className="flex items-center gap-3 min-w-0">
               <button onClick={()=>setIsSidebarOpen(!isSidebarOpen)} className="p-2 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg text-gray-500">
                 {isSidebarOpen ? <PanelLeftClose size={20}/> : <PanelLeftOpen size={20}/>}
               </button>
               <h1 className="font-bold truncate max-w-xs text-gray-800 dark:text-white">
                 {sessions.find(s=>s.id===curSessionId)?.title || 'Palink AI'}
               </h1>
           </div>
           <div className="flex items-center gap-2 relative">
               {loadingModels ? (
                 <div className="flex items-center gap-2 text-sm text-gray-400">
                   <Loader2 size={14} className="animate-spin"/>
                   <span>加载模型中...</span>
                 </div>
               ) : availableModels.length === 0 ? (
                 <div className="text-sm text-red-500 font-medium">⚠️ 暂无可用模型</div>
               ) : (
                 <div className="relative">
                    <button onClick={() => setIsModelDropdownOpen(!isModelDropdownOpen)} className="flex items-center gap-2 bg-gray-100 dark:bg-gray-800 rounded-lg px-3 py-1.5 text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors dark:text-white">
                      <span className="w-5 h-5 rounded-full overflow-hidden flex items-center justify-center bg-white dark:bg-gray-700">
                         {currentModelInfo.icon?.startsWith('data') ? <img src={currentModelInfo.icon} className="w-full h-full object-cover"/> : currentModelInfo.icon}
                      </span>
                      <span className="max-w-[100px] truncate hidden md:block">{currentModelInfo.alias}</span>
                      <ChevronDown size={14} className={`opacity-50 transition-transform ${isModelDropdownOpen?'rotate-180':''}`}/>
                    </button>
                    {isModelDropdownOpen && (
                      <>
                        <div className="fixed inset-0 z-10" onClick={() => setIsModelDropdownOpen(false)}></div>
                        <div className="absolute top-full right-0 mt-2 w-64 bg-white dark:bg-gray-900 border dark:border-gray-800 rounded-xl shadow-xl z-20 overflow-hidden py-1 max-h-[60vh] overflow-y-auto">
                          {availableModels.map(m => (
                            <button key={m.id} onClick={() => { setSettings({...settings, model: m.id}); setIsModelDropdownOpen(false); }} className={`w-full text-left px-4 py-3 flex items-center gap-3 hover:bg-gray-50 dark:hover:bg-gray-800 ${settings.model===m.id ? 'text-indigo-600 bg-indigo-50 dark:bg-indigo-900/20' : 'text-gray-700 dark:text-gray-300'}`}>
                               <div className="w-6 h-6 rounded-full flex items-center justify-center text-sm">{m.icon?.startsWith('data') ? <img src={m.icon} className="w-full h-full rounded-full"/> : m.icon}</div>
                               <div className="flex-1 truncate text-sm font-medium">{m.alias}</div>
                               {settings.model===m.id && <Check size={14}/>}
                            </button>
                          ))}
                        </div>
                      </>
                    )}
                 </div>
               )}
           </div>
        </header>
        
        <div ref={chatContainerRef} onScroll={handleScroll} className="flex-1 overflow-y-auto p-4 md:p-8 space-y-6 scroll-smooth" data-render-trigger={renderTrigger}>
           {currentMsgs.length === 0 && (
             <div className="h-full flex flex-col items-center justify-center text-gray-300 dark:text-gray-600 gap-4 select-none">
                <div className="w-20 h-20 bg-gray-50 dark:bg-gray-900 rounded-3xl flex items-center justify-center">
                  <Sparkles size={40} className="text-indigo-200 dark:text-indigo-900"/>
                </div>
                <p>开始一个新的话题...</p>
             </div>
           )}
           {currentMsgs.map((m) => (
              <MessageContent 
                key={`${m.id}-${m.lastUpdated || 0}`} role={m.role} content={m.content} reasoning={m.reasoning} isStreaming={m.isStreaming} tokens={m.tokens}
                modelInfo={m.role==='assistant' ? m : null} 
                onDelete={() => deleteMessage(m.id)} onRegenerate={() => {}} 
              />
           ))}
           <div ref={messagesEndRef} className="h-8"/>
        </div>
        
        <div className="p-6 pt-2 shrink-0 z-10 bg-gradient-to-t from-white via-white to-transparent dark:from-black dark:via-black">
            <div className="max-w-3xl mx-auto relative">
                {generatingSessions.has(curSessionId) && (
                  <div className="absolute -top-12 left-1/2 -translate-x-1/2">
                    <button onClick={stopGeneration} className="flex items-center gap-2 bg-white dark:bg-gray-800 border border-gray-200 dark