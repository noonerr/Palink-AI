# 获取本地模型列表
@app.get("/api/models/local")
async def get_local_models():
    """获取本地可用的模型列表"""
    try:
        model_manager = get_model_manager()
        models = model_manager.get_models()
        return models
    except Exception as e:
        logger.error(f"获取本地模型列表失败: {str(e)}")
        raise HTTPException(500, f"获取本地模型列表失败: {str(e)}")

@app.post("/api/admin/models/local/upload")
async def upload_local_model(
    request: Request,
    u: User = Depends(get_admin)
):
    """上传本地模型文件（仅限管理员）"""
    try:
        logger.info("开始处理模型上传请求")
        
        # 获取表单数据
        form = await request.form()
        file = form.get("file")
        
        if not file:
            logger.error("上传失败: 没有选择文件")
            raise HTTPException(400, "请选择要上传的文件")
        
        logger.info(f"接收到文件: {file.filename}")
        
        # 检查文件类型
        allowed_extensions = ['.gguf', '.ggml', '.bin', '.safetensors']
        file_extension = os.path.splitext(file.filename)[1].lower()
        if file_extension not in allowed_extensions:
            logger.error(f"上传失败: 不支持的文件类型 {file_extension}")
            raise HTTPException(400, f"不支持的文件类型，仅支持: {', '.join(allowed_extensions)}")
        
        # 确保模型目录存在
        logger.info(f"模型目录: {MODEL_DIR}")
        if not os.path.exists(MODEL_DIR):
            logger.info(f"创建模型目录: {MODEL_DIR}")
            try:
                os.makedirs(MODEL_DIR, exist_ok=True)
                os.chmod(MODEL_DIR, 0o755)
            except Exception as e:
                logger.error(f"创建模型目录失败: {e}")
                # 尝试使用临时目录
                MODEL_DIR = TEMP_MODEL_DIR
                os.makedirs(MODEL_DIR, exist_ok=True)
                os.chmod(MODEL_DIR, 0o755)
                logger.info(f"使用临时模型目录: {MODEL_DIR}")
        
        # 检查目录权限
        if not os.access(MODEL_DIR, os.W_OK):
            logger.error(f"上传失败: 模型目录没有写入权限: {MODEL_DIR}")
            # 尝试使用临时目录
            MODEL_DIR = TEMP_MODEL_DIR
            os.makedirs(MODEL_DIR, exist_ok=True)
            os.chmod(MODEL_DIR, 0o755)
            logger.info(f"使用临时模型目录: {MODEL_DIR}")
        
        # 保存文件
        file_path = os.path.join(MODEL_DIR, file.filename)
        logger.info(f"保存文件到: {file_path}")
        
        # 检查文件路径是否可写
        try:
            # 测试文件写入权限
            test_file = os.path.join(MODEL_DIR, "test_upload.txt")
            with open(test_file, "w") as f:
                f.write("test")
            os.remove(test_file)
            logger.info("文件路径可写测试成功")
        except Exception as e:
            logger.error(f"文件路径测试失败: {e}")
            # 尝试使用临时文件名
            temp_filename = f"temp_{uuid.uuid4()}{os.path.splitext(file.filename)[1]}"
            file_path = os.path.join(MODEL_DIR, temp_filename)
            logger.info(f"使用临时文件名: {file_path}")
        
        # 使用分块读取和写入，避免内存不足
        logger.info("开始分块读取和写入文件")
        chunk_size = 1024 * 1024  # 1MB chunks
        total_size = 0
        
        with open(file_path, "wb") as f:
            while True:
                try:
                    chunk = await file.read(chunk_size)
                    if not chunk:
                        break
                    f.write(chunk)
                    total_size += len(chunk)
                    logger.info(f"已写入 {total_size} 字节")
                except Exception as chunk_error:
                    logger.error(f"分块写入失败: {chunk_error}")
                    raise HTTPException(500, f"分块写入失败: {str(chunk_error)}")
        
        logger.info(f"文件写入完成，总大小: {total_size} 字节")
        
        # 检查文件是否成功保存
        if not os.path.exists(file_path):
            logger.error(f"上传失败: 文件保存失败，文件不存在: {file_path}")
            raise HTTPException(500, f"文件保存失败，文件不存在: {file_path}")
        
        saved_size = os.path.getsize(file_path)
        logger.info(f"文件保存大小: {saved_size} 字节")
        
        if saved_size != total_size:
            logger.error(f"上传失败: 文件大小不匹配，预期: {total_size} 字节，实际: {saved_size} 字节")
            raise HTTPException(500, f"文件大小不匹配，预期: {total_size} 字节，实际: {saved_size} 字节")
        
        logger.info(f"模型文件上传成功: {file.filename}, 大小: {total_size} 字节")
        
        # 重新扫描模型
        logger.info("开始重新扫描模型")
        try:
            from .model_manager import get_model_manager
            model_manager = get_model_manager()
            model_manager.scan_models()
            logger.info("模型扫描完成")
        except Exception as scan_error:
            logger.error(f"模型扫描失败: {scan_error}")
            # 模型扫描失败不影响上传结果，只记录错误
        
        return {
            "status": "ok",
            "message": "模型上传成功",
            "filename": file.filename,
            "path": file_path,
            "size": total_size
        }
    except HTTPException as e:
        logger.error(f"上传本地模型失败 (HTTPException): {e.detail}")
        raise
    except Exception as e:
        logger.error(f"上传本地模型失败 (Exception): {str(e)}")
        import traceback
        logger.error(f"详细错误信息: {traceback.format_exc()}")
        # 清理可能的部分文件
        try:
            if 'file_path' in locals() and os.path.exists(file_path):
                os.remove(file_path)
                logger.info(f"清理部分上传的文件: {file_path}")
        except:
            pass
        raise HTTPException(500, f"上传本地模型失败: {str(e)}")

@app.delete("/api/admin/models/local/{model_id}")
async def delete_local_model(
    model_id: str,
    u: User = Depends(get_admin)
):
    """删除本地模型文件（仅限管理员）"""
    try:
        from .model_manager import get_model_manager
        model_manager = get_model_manager()
        
        # 获取模型信息
        models = model_manager.get_models()
        model_to_delete = None
        for model in models:
            if model.get('id') == model_id or model.get('name') == model_id:
                model_to_delete = model
                break
        
        if not model_to_delete:
            raise HTTPException(404, f"模型不存在: {model_id}")
        
        # 获取模型文件路径
        model_path = model_to_delete.get('path')
        if not model_path:
            raise HTTPException(400, f"模型路径不存在: {model_id}")
        
        # 检查文件是否存在
        if not os.path.exists(model_path):
            raise HTTPException(404, f"模型文件不存在: {model_path}")
        
        # 删除文件
        os.remove(model_path)
        logger.info(f"删除模型文件: {model_path}")
        
        # 重新扫描模型
        model_manager.scan_models()
        logger.info(f"模型删除成功: {model_id}")
        
        return {
            "status": "ok",
            "message": "模型删除成功",
            "model_id": model_id
        }
    except HTTPException as e:
        logger.error(f"删除本地模型失败 (HTTPException): {e.detail}")
        raise
    except Exception as e:
        logger.error(f"删除本地模型失败 (Exception): {str(e)}")
        import traceback
        logger.error(f"详细错误信息: {traceback.format_exc()}")
        raise HTTPException(500, f"删除本地模型失败: {str(e)}")

